{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "email", "createdAt"]
    },
    "Task": {
      "title": "Task",
      "description": "A task for a student",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "completed": { "type": "boolean" },
        "dueDate": { "type": "string", "format": "date" },
        "priority": { "type": "string", "enum": ["low", "medium", "high"] },
        "userId": { "type": "string" },
        "groupId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "completed", "dueDate", "priority", "userId", "createdAt", "updatedAt"]
    },
    "Group": {
      "title": "Group",
      "description": "A study group or category for tasks and notes",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "color": { "type": "string" },
        "userId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "color", "userId", "createdAt"]
    },
    "Note": {
      "title": "Note",
      "description": "A note taken by a student",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "content": { "type": "string" },
        "groupId": { "type": "string" },
        "userId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "content", "groupId", "userId", "createdAt", "updatedAt"]
    },
    "StudyRoom": {
      "title": "Study Room",
      "description": "A collaborative room for group study",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "code": { "type": "string" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "activeContent": { "type": "string" }
      },
      "required": ["name", "code", "createdBy", "createdAt"]
    },
    "StudyMessage": {
      "title": "Study Message",
      "description": "A message in a study room chat",
      "type": "object",
      "properties": {
        "roomId": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "text": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["roomId", "userId", "userName", "text", "createdAt"]
    },
    "StudyMember": {
      "title": "Study Member",
      "description": "A user in a study room",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "lastSeen": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "name", "lastSeen"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "The user document"
    },
    "/groups/{groupId}": {
      "schema": "Group",
      "description": "Study groups created by users"
    },
    "/tasks/{taskId}": {
      "schema": "Task",
      "description": "Tasks created by users"
    },
    "/notes/{noteId}": {
      "schema": "Note",
      "description": "Notes created by users"
    },
    "/studyRooms/{roomId}": {
      "schema": "StudyRoom",
      "description": "Collaborative study rooms"
    },
    "/studyRooms/{roomId}/messages/{messageId}": {
      "schema": "StudyMessage",
      "description": "Messages within a study room"
    },
    "/studyRooms/{roomId}/members/{memberId}": {
      "schema": "StudyMember",
      "description": "Active members in a study room"
    }
  }
}
